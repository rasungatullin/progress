#!/bin/sh

if [ "$1" != "exec" ] || [ "$2" != "--json" ]; then
	exit 3
fi

case "$7" in
	stream)
		for value in 1 2 3 4 5 6; do
			printf '{"type":"item.completed","item":{"type":"agent_message","text":"%s"}}\n' "$value"
			sleep .1
		done
		;;
	timeout)
		printf '{"type":"thread.started","thread_id":"thread-test"}\n'
		printf '{"type":"item.completed","item":{"type":"agent_message","text":"partial"}}\n'
		sleep .5
		;;
	pause)
		printf '{"type":"thread.started","thread_id":"thread-test"}\n'
		printf '{"type":"turn.started"}\n'
		printf '{"type":"item.completed","item":{"type":"file_change","changes":[]}}\n'
		printf 'diagnostic fragment\n' >&2
		sleep .15
		printf '{"type":"item.completed","item":{"type":"agent_message","text":"continued"}}\n'
		;;
	stale-event)
		printf '{"type":"item.completed","item":{"type":"file_change","changes":[]}}\n'
		sleep .18
		printf 'late diagnostic fragment\n' >&2
		sleep .5
		;;
	*)
		exit 4
		;;
esac
