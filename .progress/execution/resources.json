{
  "defaults": {
    "model-binding": "default"
  },
  "runners": {
    "opencode": {
      "type": "opencode"
    },
    "codex": {
      "type": "codex"
    }
  },
  "models": ["openai/gpt-5.4", "openai/gpt-5.5", "gpt-5.3-codex-spark"],
  "bindings": {
    "default": {
      "runner": "opencode",
      "model": "openai/gpt-5.4"
    },
    "coder": {
      "runner": "codex",
      "model": "gpt-5.3-codex-spark"
    },
    "review": {
      "runner": "opencode",
      "model": "openai/gpt-5.5"
    }
  }
}
