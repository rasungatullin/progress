{
  "cycles": {
    "implementation-review": {
      "start_step": "execution",
      "limits": {
        "max_executions": 8
      },
      "steps": [
        {
          "name": "execution",
          "profile": "coder",
          "input_transform": {
            "task_on_repeat": "Выполнить реализацию после доработки."
          },
          "transitions": [
            {
              "to": "review",
              "in": ["ok", "approve", "approved"]
            },
            {
              "to": "review",
              "not_in": ["ok", "approve", "approved"]
            },
            {
              "to": "review",
              "missing": true
            }
          ]
        },
        {
          "name": "review",
          "profile": "review",
          "transitions": [
            {
              "finish": "completed",
              "in": ["ok", "approve", "approved"]
            },
            {
              "to": "implementation",
              "not_in": ["ok", "approve", "approved"]
            },
            {
              "to": "implementation",
              "missing": true
            }
          ]
        },
        {
          "name": "implementation",
          "profile": "coder",
          "input_transform": {
            "task_on_repeat": "Доработать результат исполнения по замечаниям ревью."
          },
          "transitions": [
            {
              "to": "review",
              "not_in": ["ok", "approve", "approved"]
            },
            {
              "to": "review",
              "in": ["ok", "approve", "approved"]
            },
            {
              "to": "review",
              "missing": true
            }
          ]
        }
      ]
    },
    "ralph-loop": {
      "start_step": "execute",
      "limits": {
        "max_executions": 4
      },
      "steps": [
        {
          "name": "execute",
          "profile": "coder",
          "input_transform": {
            "task_on_repeat": "Продолжить исполнение: устранить оставшиеся проблемы и вернуть точное заключение о готовности."
          },
          "transitions": [
            {
              "finish": "completed",
              "in": ["ok", "ready", "completed", "verified"]
            },
            {
              "to": "execute",
              "not_in": ["ok", "ready", "completed", "verified"]
            },
            {
              "to": "execute",
              "missing": true
            }
          ]
        }
      ]
    }
  }
}
