{
  "name": "apply-review-comments",
  "class": "engineering-synthesis",
  "profile": "coder",
  "aliases": [
    "address-review-comments",
    "fix-review-comments",
    "reply-review-comments"
  ],
  "requires_workplace": true,
  "requires_synthesis": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "required": true,
        "description": "Связанные канонические объекты, включая запрос на слияние для доработки по замечаниям ревизии."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      }
    }
  },
  "operations": [
    {
      "name": "prepare-data",
      "in": {
        "expected_result": {
          "ref": "in.expected_result"
        },
        "constraints": {
          "ref": "in.constraints"
        },
        "canonical_task": {
          "ref": "in.canonical_task"
        },
        "related_objects": {
          "ref": "in.related_objects"
        },
        "reasons": {
          "ref": "in.reasons"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "structured_input": {
          "ref": "data.structured_input"
        },
        "workplace": {
          "ref": "data.workplace"
        }
      }
    },
    {
      "name": "load-pull-request"
    },
    {
      "name": "load-review-remarks"
    },
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "invocation": {
          "ref": "in"
        },
        "profile": {
          "ref": "data.profile"
        }
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace"
    },
    {
      "name": "build-directive"
    },
    {
      "name": "launch-synthesis"
    },
    {
      "name": "parse-result"
    },
    {
      "name": "commit-push"
    },
    {
      "name": "publish-review-responses"
    },
    {
      "name": "finalize"
    }
  ],
  "description": "Доработка результата по замечаниям ревизии с записью ответов.",
  "expected_result": "Замечания исправлены, ветка отправлена, ответы на замечания записаны."
}
