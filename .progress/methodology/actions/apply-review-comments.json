          "ref": "in.model"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "repository_url": {
          "ref": "in.repository_url"
        }
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "directory": {
          "ref": "in.directory"
        },
        "repository_url": {
          "ref": "in.repository_url"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "base_ref": {
          "ref": "in.base_ref"
        },
        "head_ref": {
          "ref": "in.head_ref"
        },
        "allocated_environment": {
          "ref": "data.allocation.environment"
        },
        "allocated_environment_type": {
          "ref": "data.allocation.environment_type"
        },
        "action_name": {
          "ref": "action.name"
        },
        "pull_request_base_ref": {
          "ref": "in.pull_request_base_ref"
        },
        "pull_request_head_ref": {
          "ref": "in.pull_request_head_ref"
        }
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        }
      }
    },
    {
      "name": "build-prompt",
      "in": {
        "prompt": {
          "ref": "in.launch.prompt"
        },
        "prompt_additions": {
          "ref": "data.profile.prompt_additions"
        },
        "structured_output": {
          "ref": "data.profile.structured_output"
        },
        "structured_output_required": {
          "ref": "data.profile.structured_output_required"
        },
        "structured_output_fields": {
          "ref": "data.profile.structured_output_fields"
        },
        "structured_input": {
          "ref": "in.structured_input"
        },
        "review_remarks": {
          "ref": "data.review_remarks"
        }
      },
      "out": {
        "prompt": {
          "ref": "data.prompt"
        }
      }
    },
    {
      "name": "launch-synthesis",
      "in": {
        "prompt": {
          "ref": "data.prompt"
        },
        "directory": {
          "ref": "data.workplace.name"
        },
        "runner": {
          "ref": "data.allocation.runner"
        },
        "model": {
          "ref": "data.allocation.model"
        },
        "resume_session_id": {
          "ref": "in.launch.resume.runner_session_id"
        }
      },
      "out": {
        "raw_output": {
          "ref": "data.raw_output"
        },
        "session_id": {
          "ref": "data.session_id"
        }
      }
    },
    {
      "name": "parse-result",
      "in": {
        "raw_output": {
          "ref": "data.raw_output"
        },
        "session_id": {
          "ref": "data.session_id"
        }
      },
      "out": {
        "structured_output": {
          "ref": "data.structured_output"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "commit-push",
      "in": {
        "directory": {
          "ref": "data.workplace.name"
        },
        "commit_message": {
          "ref": "data.structured_output.commit_message"
