{
  "name": "apply-review-comments",
  "class": "engineering-synthesis",
  "profile": "review-rework",
  "aliases": [
    "address-review-comments",
    "fix-review-comments",
    "reply-review-comments"
  ],
  "requires_workplace": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "required": true,
        "description": "Связанные канонические объекты, включая запрос на слияние для доработки по замечаниям ревизии."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "invocation": {
        "type": "object",
        "description": "Ввод контура исполнения, синхронизированный с параметрами запроса на слияние."
      },
      "pull_request": {
        "type": "object",
        "description": "Загруженный запрос на слияние для последующих операций действия."
      },
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "commit_summary": {
        "type": "string",
        "description": "Сводка создания коммита и отправки ветки."
      },
      "review_remarks": {
        "type": "object_array",
        "description": "Загруженные замечания ревизии для поиска цепочек обсуждения."
      },
      "review_responses_summary": {
        "type": "string",
        "description": "Сводка записи ответов на замечания и закрытия цепочек обсуждения."
      },
      "prompt": {
        "type": "string",
        "description": "Готовая исполнительная директива."
      },
      "raw_output": {
        "type": "string",
        "description": "Фактический вывод исполнительного модуля."
      },
      "session_id": {
        "type": "string",
        "description": "Идентификатор сеанса исполнительного модуля."
      }
    }
  },
  "operations": [
    {
