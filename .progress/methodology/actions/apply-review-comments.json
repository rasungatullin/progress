        "fallback_name": {
          "ref": "in.workplace_name"
        },
        "git": {
          "ref": "data.allocation.git"
        },
        "private_store": {
          "ref": "data.allocation.private_store"
        },
        "config_home": {
          "ref": "data.allocation.config_home"
        }
      },
      "out": {
        "commit_summary": {
          "ref": "data.commit_summary"
        }
      }
    },
    {
      "name": "publish-review-responses",
      "in": {
        "invocation": {
          "ref": "data.invocation"
        },
        "result": {
          "ref": "data.result"
        },
        "structured_output": {
          "ref": "data.structured_output"
        },
        "review_remarks": {
          "ref": "data.review_remarks"
        }
      },
      "out": {
        "review_responses_summary": {
          "ref": "data.review_responses_summary"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Доработка результата по замечаниям ревизии с записью ответов.",
  "expected_result": "Замечания исправлены, ветка отправлена, ответы на замечания записаны."
}
