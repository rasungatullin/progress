{
  "name": "integration-change",
  "class": "integration-change",
  "profile": "default",
  "aliases": [
    "comment",
    "integration",
    "pull-request"
  ],
  "requires_workplace": false,
  "requires_synthesis": false,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "description": "Связанные канонические объекты."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      }
    }
  },
  "operations": [
    {
      "name": "prepare-data",
      "in": {
        "expected_result": {
          "ref": "in.expected_result"
        },
        "constraints": {
          "ref": "in.constraints"
        },
        "canonical_task": {
          "ref": "in.canonical_task"
        },
        "related_objects": {
          "ref": "in.related_objects"
        },
        "reasons": {
          "ref": "in.reasons"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "structured_input": {
          "ref": "data.structured_input"
        },
        "workplace": {
          "ref": "data.workplace"
        }
      }
    },
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        }
      }
    },
    {
      "name": "allocate-resources"
    },
    {
      "name": "prepare-workplace"
    },
    {
      "name": "build-directive"
    },
    {
      "name": "launch-synthesis"
    },
    {
      "name": "parse-result"
    },
    {
      "name": "finalize"
    }
  ],
  "description": "Интеграционное изменение через опубликованную операцию.",
  "expected_result": "Выполнить интеграционное изменение через опубликованную операцию."
}
