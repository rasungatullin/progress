{
  "name": "review-pull-request",
  "class": "review",
  "profile": "review",
  "aliases": [
    "pr-review",
    "review",
    "review-pr"
  ],
  "requires_workplace": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "required": true,
        "description": "Связанные канонические объекты, включая запрос на слияние для ревизии."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "invocation": {
        "type": "object",
        "description": "Ввод контура исполнения, синхронизированный с параметрами запроса на слияние."
      },
      "pull_request": {
        "type": "object",
        "description": "Загруженный запрос на слияние для последующих операций действия."
      },
      "review_remarks": {
        "type": "object_array",
        "description": "Загруженные замечания ревизии для передачи в контур исполнения."
      },
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "directive": {
        "type": "object",
        "description": "Подготовленная исполнительная директива для запуска выполнения."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "review_remarks_summary": {
        "type": "string",
        "description": "Сводка записи замечаний ревизии."
      }
    }
  },
  "operations": [
    {
      "name": "load-pull-request",
      "in": {
        "repository": {
          "ref": "in.repository_url"
        },
        "number": {
          "ref": "in.number"
        },
        "base_ref": {
          "ref": "in.base_ref"
        },
        "head_ref": {
          "ref": "in.head_ref"
        }
      },
      "out": {
        "pull_request": {
          "ref": "data.pull_request"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "load-review-remarks",
      "in": {
        "repository": {
          "ref": "in.repository_url"
        },
        "number": {
          "ref": "data.pull_request.number"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "review_remarks": {
          "ref": "data.review_remarks"
        },
        "result": {
          "ref": "data.result"
        },
        "structured_input": {
          "ref": "data.structured_input"
        }
      }
    },
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "model_binding": {
          "ref": "in.model_binding"
        },
        "allow_model_fallback": {
          "ref": "data.profile.allow_model_fallback"
        },
        "runner": {
          "ref": "in.runner"
        },
        "model": {
          "ref": "in.model"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "repository_url": {
          "ref": "in.repository_url"
        }
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "directory": {
          "ref": "in.directory"
        },
        "repository_url": {
          "ref": "in.repository_url"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "base_ref": {
          "ref": "in.base_ref"
        },
        "head_ref": {
          "ref": "in.head_ref"
        },
        "allocated_environment": {
          "ref": "data.allocation.environment"
        },
        "allocated_environment_type": {
          "ref": "data.allocation.environment_type"
        },
        "action_name": {
          "ref": "action.name"
        },
        "pull_request_base_ref": {
          "ref": "in.pull_request_base_ref"
        },
        "pull_request_head_ref": {
          "ref": "in.pull_request_head_ref"
        }
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        }
      }
    },
    {
      "name": "build-directive",
      "in": {
        "directory": {
          "ref": "data.workplace.name"
        },
        "runner": {
          "ref": "data.allocation.runner"
        },
        "model": {
          "ref": "data.allocation.model"
        },
        "model_binding": {
          "ref": "data.allocation.model_binding"
        }
      },
      "out": {
        "directive": {
          "ref": "data.directive"
        }
      }
    },
    {
      "name": "launch-synthesis",
      "in": {
        "directive": {
          "ref": "data.directive"
        },
        "task": {
          "ref": "in.task"
        },
        "action": {
          "ref": "in.action"
        },
        "directory": {
          "ref": "data.workplace.name"
        },
        "profile_name": {
          "ref": "data.profile.name"
        },
        "prompt_additions": {
          "ref": "data.profile.prompt_additions"
        },
        "profile_structured_output": {
          "ref": "data.profile.structured_output"
        },
        "profile_structured_output_required": {
          "ref": "data.profile.structured_output_required"
        },
        "profile_structured_output_fields": {
          "ref": "data.profile.structured_output_fields"
        },
        "runner": {
          "ref": "data.allocation.runner"
        },
        "model": {
          "ref": "data.allocation.model"
        },
        "model_binding": {
          "ref": "data.allocation.model_binding"
        },
        "workplace_name": {
          "ref": "data.workplace.name"
        },
        "repository_url": {
          "ref": "in.repository_url"
        },
        "structured_input": {
          "ref": "data.structured_input"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "parse-result",
      "in": {
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "structured_output": {
          "ref": "data.structured_output"
        }
      }
    },
    {
      "name": "publish-review-remarks",
      "in": {
        "repository": {
          "ref": "in.repository_url"
        },
        "number": {
          "ref": "data.pull_request.number"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.structured_output"
        }
      },
      "out": {
        "review_remarks_summary": {
          "ref": "data.review_remarks_summary"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Ревизия открытого запроса на слияние с записью замечаний.",
  "expected_result": "Замечания ревизии или заключение записаны во внешнюю систему."
}
