{
  "name": "review-pull-request",
  "class": "review",
  "profile": "review",
  "aliases": [
    "pr-review",
    "review",
    "review-pr"
  ],
  "requires_workplace": true,
  "requires_synthesis": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "required": true,
        "description": "Связанные канонические объекты, включая запрос на слияние для ревизии."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "invocation": {
        "type": "object",
        "description": "Ввод контура исполнения, синхронизированный с параметрами запроса на слияние."
      },
      "pull_request": {
        "type": "object",
        "description": "Загруженный запрос на слияние для последующих операций действия."
      },
      "review_remarks": {
        "type": "object_array",
        "description": "Загруженные замечания ревизии для передачи в контур исполнения."
      },
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "directive": {
        "type": "object",
        "description": "Подготовленная исполнительная директива для запуска выполнения."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "review_remarks_summary": {
        "type": "string",
        "description": "Сводка записи замечаний ревизии."
      }
    }
  },
  "operations": [
    {
      "name": "prepare-data",
      "in": {
        "task": {"ref": "in.task"},
        "action": {"ref": "in.action"},
        "repository_url": {"ref": "in.repository_url"},
        "workplace_name": {"ref": "in.workplace_name"},
        "base_ref": {"ref": "in.base_ref"},
        "head_ref": {"ref": "in.head_ref"},
        "expected_result": {
          "ref": "in.expected_result"
        },
        "constraints": {
          "ref": "in.constraints"
        },
        "canonical_task": {
          "ref": "in.canonical_task"
        },
        "related_objects": {
          "ref": "in.related_objects"
        },
        "reasons": {
          "ref": "in.reasons"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "structured_input": {
          "ref": "data.structured_input"
        },
        "workplace": {
          "ref": "data.workplace"
        },
        "repository": {"ref": "data.invocation.repository.url"},
        "number": {"ref": "data.invocation.assignment.canonical_task.number"},
        "base_ref": {"ref": "data.invocation.workplace.base_ref"},
        "head_ref": {"ref": "data.invocation.workplace.head_ref"}
      }
    },
    {
      "name": "load-pull-request",
      "in": {
        "repository": {"ref": "data.invocation.repository.url"},
        "number": {"ref": "data.invocation.assignment.canonical_task.number"},
        "base_ref": {"ref": "data.invocation.workplace.base_ref"},
        "head_ref": {"ref": "data.invocation.workplace.head_ref"}
      },
      "out": {
        "pull_request": {
          "ref": "data.pull_request"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "load-review-remarks",
      "in": {
        "repository": {"ref": "data.invocation.repository.url"},
        "number": {"ref": "data.pull_request.number"}
      },
      "out": {
        "review_remarks": {
          "ref": "data.review_remarks"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "model_binding": {"ref": "data.invocation.launch.model_binding"},
        "allow_model_fallback": {"ref": "data.profile.allow_model_fallback"},
        "runner": {"ref": "data.invocation.launch.runner"},
        "model": {"ref": "data.invocation.launch.model"},
        "environment": {"ref": "data.invocation.workplace.environment"},
        "workplace_name": {"ref": "data.invocation.workplace.name"},
        "repository_url": {"ref": "data.invocation.repository.url"}
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "directory": {"ref": "data.invocation.launch.directory"},
        "repository_url": {"ref": "data.invocation.repository.url"},
        "environment": {"ref": "data.invocation.workplace.environment"},
        "workplace_name": {"ref": "data.invocation.workplace.name"},
        "base_ref": {"ref": "data.invocation.workplace.base_ref"},
        "head_ref": {"ref": "data.invocation.workplace.head_ref"},
        "allocated_environment": {"ref": "data.allocation.environment"},
        "allocated_environment_type": {"ref": "data.allocation.environment_type"}
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        },
        "invocation": {
          "ref": "data.invocation"
        }
      }
    },
    {
      "name": "build-directive",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "directory": {"ref": "data.invocation.launch.directory"},
        "runner": {"ref": "data.allocation.runner"},
        "model": {"ref": "data.allocation.model"},
        "model_binding": {"ref": "data.allocation.model_binding"}
      },
      "out": {
        "directive": {
          "ref": "data.directive"
        }
      }
    },
    {
      "name": "launch-synthesis",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "directive": {
          "ref": "data.directive"
        },
        "task": {"ref": "data.invocation.task"},
        "action": {"ref": "data.invocation.action"},
        "directory": {"ref": "data.invocation.launch.directory"},
        "profile_name": {"ref": "data.profile.name"},
        "prompt_additions": {"ref": "data.profile.prompt_additions"},
        "profile_structured_output": {"ref": "data.profile.structured_output"},
        "profile_structured_output_required": {"ref": "data.profile.structured_output_required"},
        "profile_structured_output_fields": {"ref": "data.profile.structured_output_fields"},
        "runner": {"ref": "data.allocation.runner"},
        "model": {"ref": "data.allocation.model"},
        "model_binding": {"ref": "data.allocation.model_binding"},
        "workplace_name": {"ref": "data.workplace.name"},
        "repository_url": {"ref": "data.invocation.repository.url"},
        "structured_input": {"ref": "data.invocation.launch.structured_input"}
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "parse-result",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "structured_output": {
          "ref": "data.structured_output"
        }
      }
    },
    {
      "name": "publish-review-remarks",
      "in": {
        "repository": {"ref": "data.invocation.repository.url"},
        "number": {"ref": "data.pull_request.number"},
        "result_status": {"ref": "data.result.status"},
        "result_summary": {"ref": "data.result.summary"},
        "structured_output": {
          "ref": "data.structured_output"
        }
      },
      "out": {
        "review_remarks_summary": {
          "ref": "data.review_remarks_summary"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {"ref": "data.result.status"},
        "result_summary": {"ref": "data.result.summary"},
        "structured_output": {"ref": "data.result.structured_output"}
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Ревизия открытого запроса на слияние с записью замечаний.",
  "expected_result": "Замечания ревизии или заключение записаны во внешнюю систему."
}
