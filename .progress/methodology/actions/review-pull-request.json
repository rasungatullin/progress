{
  "name": "review-pull-request",
  "class": "review",
  "profile": "review",
  "aliases": [
    "pr-review",
    "review",
    "review-pr"
  ],
  "requires_workplace": true,
  "requires_synthesis": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "required": true,
        "description": "Связанные канонические объекты, включая запрос на слияние для ревизии."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "invocation": {
        "type": "object",
        "description": "Ввод контура исполнения, синхронизированный с параметрами запроса на слияние."
      },
      "pull_request": {
        "type": "object",
        "description": "Загруженный запрос на слияние для последующих операций действия."
      },
      "review_remarks": {
        "type": "object_array",
        "description": "Загруженные замечания ревизии для передачи в контур исполнения."
      },
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "directive": {
        "type": "object",
        "description": "Подготовленная исполнительная директива для запуска выполнения."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "review_remarks_summary": {
        "type": "string",
        "description": "Сводка записи замечаний ревизии."
      }
    }
  },
  "operations": [
    {
      "name": "prepare-data",
      "in": {
        "expected_result": {
          "ref": "in.expected_result"
        },
        "constraints": {
          "ref": "in.constraints"
        },
        "canonical_task": {
          "ref": "in.canonical_task"
        },
        "related_objects": {
          "ref": "in.related_objects"
        },
        "reasons": {
          "ref": "in.reasons"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "structured_input": {
          "ref": "data.structured_input"
        },
        "workplace": {
          "ref": "data.workplace"
        },
        "invocation": {
          "ref": "data.invocation"
        }
      }
    },
    {
      "name": "load-pull-request",
      "in": {
        "invocation": {
          "ref": "data.invocation"
        }
      },
      "out": {
        "pull_request": {
          "ref": "data.pull_request"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "load-review-remarks",
      "in": {
        "invocation": {
          "ref": "data.invocation"
        },
        "pull_request": {
          "ref": "data.pull_request"
        }
      },
      "out": {
        "review_remarks": {
          "ref": "data.review_remarks"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        },
        "invocation": {
          "ref": "data.invocation"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "profile": {
          "ref": "data.profile"
        }
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "profile": {
          "ref": "data.profile"
        },
        "allocation": {
          "ref": "data.allocation"
        }
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        },
        "invocation": {
          "ref": "data.invocation"
        }
      }
    },
    {
      "name": "build-directive",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "profile": {
          "ref": "data.profile"
        },
        "allocation": {
          "ref": "data.allocation"
        },
        "workplace": {
          "ref": "data.workplace"
        }
      },
      "out": {
        "directive": {
          "ref": "data.directive"
        }
      }
    },
    {
      "name": "launch-synthesis",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "directive": {
          "ref": "data.directive"
        },
        "profile": {
          "ref": "data.profile"
        },
        "allocation": {
          "ref": "data.allocation"
        },
        "workplace": {
          "ref": "data.workplace"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "parse-result",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "result": {
          "ref": "data.result"
        }
      },
      "out": {
        "structured_output": {
          "ref": "data.structured_output"
        }
      }
    },
    {
      "name": "publish-review-remarks",
      "in": {
        "invocation": {
          "ref": "data.invocation"
        },
        "result": {
          "ref": "data.result"
        },
        "structured_output": {
          "ref": "data.structured_output"
        }
      },
      "out": {
        "review_remarks_summary": {
          "ref": "data.review_remarks_summary"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "invocation": {
          "ref": "data.invocation"
        },
        "profile": {
          "ref": "data.profile"
        },
        "allocation": {
          "ref": "data.allocation"
        },
        "workplace": {
          "ref": "data.workplace"
        },
        "result": {
          "ref": "data.result"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Ревизия открытого запроса на слияние с записью замечаний.",
  "expected_result": "Замечания ревизии или заключение записаны во внешнюю систему."
}
