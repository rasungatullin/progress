{
  "name": "service",
  "class": "service",
  "profile": "default",
  "aliases": [
    "diagnostic",
    "diagnostics"
  ],
  "requires_workplace": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "description": "Связанные канонические объекты."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      }
    }
  },
  "operations": [
    {
      "name": "finalize",
      "in": {
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Служебное действие без содержательного синтеза.",
  "expected_result": "Выполнить служебное действие без содержательного синтеза."
}
