{
  "name": "task-description-assessment",
  "class": "task-preparation",
  "profile": "task-description-assessor",
  "aliases": [
    "assess",
    "assess-description",
    "description-assessment",
    "prepare-task"
  ],
  "requires_workplace": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "description": "Связанные канонические объекты."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "prompt": {
        "type": "string",
        "description": "Готовая исполнительная директива."
      },
      "raw_output": {
        "type": "string",
        "description": "Фактический вывод исполнительного модуля."
      },
      "session_id": {
        "type": "string",
        "description": "Идентификатор сеанса исполнительного модуля."
      }
    }
  },
  "operations": [
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "model_binding": {
          "ref": "data.profile.model_binding"
        },
        "allow_model_fallback": {
          "ref": "data.profile.allow_model_fallback"
        },
        "runner": {
          "ref": "in.runner"
        },
        "model": {
          "ref": "in.model"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "repository_url": {
          "ref": "in.repository_url"
        }
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "directory": {
          "ref": "in.directory"
        },
        "repository_url": {
          "ref": "in.repository_url"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "base_ref": {
          "ref": "in.base_ref"
        },
        "head_ref": {
          "ref": "in.head_ref"
        },
        "allocated_environment": {
          "ref": "data.allocation.environment"
        },
        "allocated_environment_type": {
          "ref": "data.allocation.environment_type"
        },
        "action_name": {
          "ref": "action.name"
        },
        "pull_request_base_ref": {
          "ref": "in.pull_request_base_ref"
        },
        "pull_request_head_ref": {
          "ref": "in.pull_request_head_ref"
        }
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        }
      }
    },
    {
      "name": "build-prompt",
      "in": {
        "prompt": {
          "ref": "in.launch.prompt"
        },
        "prompt_additions": {
          "ref": "data.profile.prompt_additions"
        },
        "structured_output": {
          "ref": "data.profile.structured_output"
        },
        "structured_output_required": {
          "ref": "data.profile.structured_output_required"
        },
        "structured_output_fields": {
          "ref": "data.profile.structured_output_fields"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "prompt": {
          "ref": "data.prompt"
        }
      }
    },
    {
      "name": "launch-synthesis",
      "in": {
        "prompt": {
          "ref": "data.prompt"
        },
        "directory": {
          "ref": "data.workplace.name"
        },
        "runner": {
          "ref": "data.allocation.runner"
        },
        "model": {
          "ref": "data.allocation.model"
        },
        "resume_session_id": {
          "ref": "in.launch.resume.runner_session_id"
        }
      },
      "out": {
        "raw_output": {
          "ref": "data.raw_output"
        },
        "session_id": {
          "ref": "data.session_id"
        }
      }
    },
    {
      "name": "parse-result",
      "in": {
        "raw_output": {
          "ref": "data.raw_output"
        },
        "session_id": {
          "ref": "data.session_id"
        }
      },
      "out": {
        "structured_output": {
          "ref": "data.structured_output"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Оценка достаточности описания задачи без изменения кодовой базы.",
  "expected_result": "Сформировать заключение о достаточности описания."
}
