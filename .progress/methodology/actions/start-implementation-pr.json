{
  "name": "start-implementation-pr",
  "class": "engineering-synthesis",
  "profile": "coder",
  "aliases": [
    "code",
    "code-commit",
    "coder",
    "coding",
    "implement",
    "implement-commit",
    "implement-pr",
    "implementation",
    "implementation-pr",
    "open-pr",
    "start-implementation"
  ],
  "requires_workplace": true,
  "requires_synthesis": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "description": "Связанные канонические объекты."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "directive": {
        "type": "object",
        "description": "Подготовленная исполнительная директива для запуска выполнения."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "commit_summary": {
        "type": "string",
        "description": "Сводка создания коммита и отправки ветки."
      },
      "merge_request": {
        "type": "object",
        "description": "Опубликованный запрос на слияние."
      },
      "publish_summary": {
        "type": "string",
        "description": "Сводка публикации запроса на слияние."
      }
    }
  },
  "operations": [
    {
      "name": "prepare-data",
      "in": {
        "task": {"ref": "in.task"},
        "action": {"ref": "in.action"},
        "repository_url": {"ref": "in.repository_url"},
        "workplace_name": {"ref": "in.workplace_name"},
        "base_ref": {"ref": "in.base_ref"},
        "head_ref": {"ref": "in.head_ref"},
        "expected_result": {
          "ref": "in.expected_result"
        },
        "constraints": {
          "ref": "in.constraints"
        },
        "canonical_task": {
          "ref": "in.canonical_task"
        },
        "related_objects": {
          "ref": "in.related_objects"
        },
        "reasons": {
          "ref": "in.reasons"
        },
        "structured_input": {
          "ref": "in.structured_input"
        }
      },
      "out": {
        "structured_input": {
          "ref": "data.structured_input"
        },
        "workplace": {
          "ref": "data.workplace"
        },
        "invocation": {
          "ref": "data.invocation"
        }
      }
    },
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "model_binding": {"ref": "data.invocation.launch.model_binding"},
        "runner": {"ref": "data.invocation.launch.runner"},
        "model": {"ref": "data.invocation.launch.model"},
        "environment": {"ref": "data.invocation.workplace.environment"},
        "workplace_name": {"ref": "data.invocation.workplace.name"},
        "repository_url": {"ref": "data.invocation.repository.url"}
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "directory": {"ref": "data.invocation.launch.directory"},
        "repository_url": {"ref": "data.invocation.repository.url"},
        "environment": {"ref": "data.invocation.workplace.environment"},
        "workplace_name": {"ref": "data.invocation.workplace.name"},
        "base_ref": {"ref": "data.invocation.workplace.base_ref"},
        "head_ref": {"ref": "data.invocation.workplace.head_ref"},
        "allocated_environment": {"ref": "data.allocation.environment"},
        "allocated_environment_type": {"ref": "data.allocation.environment_type"}
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        },
        "invocation": {
          "ref": "data.invocation"
        }
      }
    },
    {
      "name": "build-directive",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "directory": {"ref": "data.invocation.launch.directory"},
        "runner": {"ref": "data.allocation.runner"},
        "model": {"ref": "data.allocation.model"},
        "model_binding": {"ref": "data.allocation.model_binding"}
      },
      "out": {
        "directive": {
          "ref": "data.directive"
        }
      }
    },
    {
      "name": "launch-synthesis",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "directive": {
          "ref": "data.directive"
        },
        "task": {"ref": "data.invocation.task"},
        "action": {"ref": "data.invocation.action"},
        "directory": {"ref": "data.invocation.launch.directory"},
        "profile_name": {"ref": "data.profile.name"},
        "runner": {"ref": "data.allocation.runner"},
        "model": {"ref": "data.allocation.model"},
        "model_binding": {"ref": "data.allocation.model_binding"},
        "workplace_name": {"ref": "data.workplace.name"},
        "repository_url": {"ref": "data.invocation.repository.url"},
        "structured_input": {"ref": "data.invocation.launch.structured_input"}
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "parse-result",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "structured_output": {
          "ref": "data.structured_output"
        }
      }
    },
    {
      "name": "commit-push",
      "in": {
        "directory": {
          "ref": "data.workplace.name"
        },
        "commit_message": {
          "ref": "data.structured_output.commit_message"
        },
        "fallback_name": {
          "ref": "data.invocation.workplace.name"
        },
        "git": {
          "ref": "data.allocation.git"
        },
        "private_store": {
          "ref": "data.allocation.private_store"
        },
        "config_home": {
          "ref": "data.allocation.config_home"
        }
      },
      "out": {
        "commit_summary": {
          "ref": "data.commit_summary"
        }
      }
    },
    {
      "name": "publish-merge-request",
      "in": {
        "invocation": {
          "ref": "data.invocation"
        },
        "profile": {
          "ref": "data.profile"
        },
        "allocation": {
          "ref": "data.allocation"
        },
        "workplace": {
          "ref": "data.workplace"
        },
        "result": {
          "ref": "data.result"
        },
        "structured_output": {
          "ref": "data.structured_output"
        }
      },
      "out": {
        "merge_request": {
          "ref": "data.merge_request"
        },
        "publish_summary": {
          "ref": "data.publish_summary"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "requires_synthesis": {
          "ref": "action.requires_synthesis"
        },
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {"ref": "data.result.status"},
        "result_summary": {"ref": "data.result.summary"},
        "structured_output": {"ref": "data.result.structured_output"}
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Реализация задачи с отправкой ветки и открытием запроса на слияние.",
  "expected_result": "Изменение реализовано, ветка отправлена, запрос на слияние открыт."
}
