{
  "name": "start-implementation-pr",
  "class": "engineering-synthesis",
  "profile": "coder",
  "aliases": [
    "code",
    "code-commit",
    "coder",
    "coding",
    "implement",
    "implement-commit",
    "implement-pr",
    "implementation",
    "implementation-pr",
    "open-pr",
    "start-implementation"
  ],
  "requires_workplace": true,
  "contract": {
    "in": {
      "expected_result": {
        "type": "string",
        "required": true,
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "required": true,
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "description": "Связанные канонические объекты."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "required": true,
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "data": {
      "profile": {
        "type": "object",
        "description": "Разрешённый исполнительный профиль для последующих операций действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "head_ref": {
        "type": "string",
        "description": "Разрешённая ветка исполнительного рабочего места."
      },
      "base_ref": {
        "type": "string",
        "description": "Фактическая базовая ветка исполнительного рабочего места."
      },
      "allocation": {
        "type": "object",
        "description": "Результат ресурсного снабжения для последующих операций действия."
      },
      "result": {
        "type": "object",
        "description": "Результат запуска выполнения."
      },
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      },
      "commit_summary": {
        "type": "string",
        "description": "Сводка создания коммита и отправки ветки."
      },
      "merge_request": {
        "type": "object",
        "description": "Опубликованный запрос на слияние."
      },
      "publish_summary": {
        "type": "string",
        "description": "Сводка публикации запроса на слияние."
      }
    }
  },
  "operations": [
    {
      "name": "resolve-profile",
      "in": {
        "profile_name": {
          "ref": "action.profile"
        }
      },
      "out": {
        "profile": {
          "ref": "data.profile"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "allocate-resources",
      "in": {
        "model_binding": {
          "ref": "data.profile.model_binding"
        },
        "allow_model_fallback": {
          "ref": "data.profile.allow_model_fallback"
        },
        "runner": {
          "ref": "in.runner"
        },
        "model": {
          "ref": "in.model"
        },
        "reasoning_effort": {
          "ref": "in.launch.reasoning_effort"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "repository_url": {
          "ref": "in.repository_url"
        }
      },
      "out": {
        "allocation": {
          "ref": "data.allocation"
        }
      }
    },
    {
      "name": "prepare-workplace",
      "in": {
        "requires_workplace": {
          "ref": "action.requires_workplace"
        },
        "directory": {
          "ref": "in.directory"
        },
        "repository_url": {
          "ref": "in.repository_url"
        },
        "environment": {
          "ref": "in.environment"
        },
        "workplace_name": {
          "ref": "in.workplace_name"
        },
        "base_ref": {
          "ref": "in.base_ref"
        },
        "head_ref": {
          "ref": "in.head_ref"
        },
        "allocated_environment": {
          "ref": "data.allocation.environment"
        },
        "allocated_environment_type": {
          "ref": "data.allocation.environment_type"
        },
        "action_name": {
          "ref": "action.name"
        },
        "pull_request_base_ref": {
          "ref": "in.pull_request_base_ref"
        },
        "pull_request_head_ref": {
          "ref": "in.pull_request_head_ref"
        }
      },
      "out": {
        "workplace": {
          "ref": "data.workplace"
        },
        "base_ref": {
          "ref": "data.base_ref"
        },
        "head_ref": {
          "ref": "data.head_ref"
        }
      }
    },
    {
      "name": "structured-synthesis",
      "in": {
        "prompt": {
          "ref": "in.launch.prompt"
        },
        "prompt_additions": {
          "ref": "data.profile.prompt_additions"
        },
        "structured_input": {
          "ref": "in.structured_input"
        },
        "structured_output_fields": {
          "ref": "data.profile.structured_output_fields"
        },
        "directory": {
          "ref": "data.workplace.name"
        },
        "runner": {
          "ref": "data.allocation.runner"
        },
        "model": {
          "ref": "data.allocation.model"
        },
        "reasoning_effort": {
          "ref": "data.allocation.reasoning_effort"
        },
        "resume_session_id": {
          "ref": "in.launch.resume.runner_session_id"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        },
        "structured_output": {
          "ref": "data.structured_output"
        }
      }
    },
    {
      "name": "commit-push",
      "in": {
        "directory": {
          "ref": "data.workplace.name"
        },
        "commit_message": {
          "ref": "data.structured_output.commit_message"
        },
        "fallback_name": {
          "ref": "in.workplace_name"
        },
        "git": {
          "ref": "data.allocation.git"
        },
        "private_store": {
          "ref": "data.allocation.private_store"
        },
        "config_home": {
          "ref": "data.allocation.config_home"
        }
      },
      "out": {
        "commit_summary": {
          "ref": "data.commit_summary"
        }
      }
    },
    {
      "name": "publish-merge-request",
      "in": {
        "repository": {
          "ref": "in.repository_url"
        },
        "title": {
          "ref": "data.structured_output.summary"
        },
        "body": {
          "ref": "data.structured_output.summary"
        },
        "base_ref": {
          "ref": "data.base_ref"
        },
        "head_ref": {
          "ref": "data.head_ref"
        },
        "draft": {
          "ref": "data.pull_request.draft"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.structured_output"
        }
      },
      "out": {
        "merge_request": {
          "ref": "data.merge_request"
        },
        "publish_summary": {
          "ref": "data.publish_summary"
        },
        "result": {
          "ref": "data.result"
        }
      }
    },
    {
      "name": "finalize",
      "in": {
        "action_name": {
          "ref": "action.name"
        },
        "action_class": {
          "ref": "action.class"
        },
        "result_status": {
          "ref": "data.result.status"
        },
        "result_summary": {
          "ref": "data.result.summary"
        },
        "structured_output": {
          "ref": "data.result.structured_output"
        }
      },
      "out": {
        "result": {
          "ref": "data.result"
        }
      }
    }
  ],
  "description": "Реализация задачи с отправкой ветки и открытием запроса на слияние.",
  "expected_result": "Изменение реализовано, ветка отправлена, запрос на слияние открыт."
}
