{
  "name": "publish-merge-request",
  "kind": "repository.merge-request.create",
  "title": "Открытие запроса на слияние",
  "type": "integration",
  "required": true,
  "contract": {
    "in": {
      "repository": {"type": "string", "required": true, "description": "Репозиторий запроса на слияние."},
      "title": {"type": "string", "description": "Заголовок запроса на слияние."},
      "body": {"type": "string", "description": "Описание запроса на слияние."},
      "base_ref": {"type": "string", "required": true, "description": "Базовая ветка запроса."},
      "head_ref": {"type": "string", "required": true, "description": "Ветка источника запроса."},
      "draft": {"type": "boolean", "description": "Признак чернового запроса."},
      "result_status": {"type": "string", "description": "Состояние выполнения перед публикацией."},
      "result_summary": {"type": "string", "description": "Сводка выполнения перед публикацией."},
      "structured_output": {
        "type": "object",
        "description": "Нормализованный структурированный результат выполнения."
      }
    },
    "out": {
      "merge_request": {
        "type": "object",
        "description": "Опубликованный запрос на слияние."
      },
      "publish_summary": {
        "type": "string",
        "description": "Сводка публикации запроса на слияние."
      },
      "result": {
        "type": "object",
        "required": true,
        "description": "Результат выполнения с учётом публикации запроса на слияние."
      }
    }
  }
}
