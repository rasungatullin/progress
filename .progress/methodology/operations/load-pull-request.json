{
  "name": "load-pull-request",
  "kind": "load-pull-request",
  "title": "Получение запроса на слияние",
  "type": "builtin",
  "required": true,
  "contract": {
    "in": {
      "repository": {
        "type": "string",
        "required": true,
        "description": "Репозиторий запроса на слияние."
      },
      "number": {
        "type": "integer",
        "required": true,
        "description": "Номер запроса на слияние."
      },
      "base_ref": {
        "type": "string",
        "description": "Базовая ветка запроса на слияние."
      },
      "head_ref": {
        "type": "string",
        "description": "Ветка источника запроса на слияние."
      }
    },
    "out": {
      "pull_request": {
        "type": "object",
        "required": true,
        "description": "Загруженный запрос на слияние из контура интеграции."
      },
      "result": {
        "type": "object",
        "required": false,
        "description": "Результат отказа при невозможности получить запрос на слияние."
      }
    }
  }
}
