{
  "name": "prepare-data",
  "kind": "prepare-data",
  "title": "Подготовка данных",
  "origin": "builtin",
  "required": true,
  "contract": {
    "in": {
      "task": {"type": "string", "description": "Текст задачи для подготовки данных."},
      "action": {"type": "string", "description": "Имя действия задания."},
      "repository_url": {"type": "string", "description": "Адрес репозитория задания."},
      "workplace_name": {"type": "string", "description": "Имя рабочего места задания."},
      "base_ref": {"type": "string", "description": "Базовая ветка задания."},
      "head_ref": {"type": "string", "description": "Ветка задания."},
      "expected_result": {
        "type": "string",
        "description": "Ожидаемый результат выполнения действия."
      },
      "constraints": {
        "type": "string_array",
        "description": "Ограничения маршрута обработки."
      },
      "canonical_task": {
        "type": "object",
        "description": "Каноническая задача, восстановленная по внешнему рабочему объекту."
      },
      "related_objects": {
        "type": "object_array",
        "description": "Связанные канонические объекты."
      },
      "reasons": {
        "type": "object_array",
        "description": "Основания выбора действия."
      },
      "structured_input": {
        "type": "object",
        "description": "Структурированный ввод для контура исполнения."
      }
    },
    "out": {
      "structured_input": {
        "type": "object",
        "description": "Подготовленный структурированный ввод для запуска исполнения."
      },
      "workplace": {
        "type": "object",
        "description": "Подготовленная спецификация рабочего места с синхронизированными ветками."
      },
      "invocation": {
        "type": "object",
        "required": true,
        "description": "Подготовленный ввод контура исполнения."
      }
    }
  }
}
