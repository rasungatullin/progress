{
  "name": "build-directive",
  "kind": "build-directive",
  "title": "Сборка исполнительной директивы",
  "origin": "builtin",
  "required": true,
  "contract": {
    "in": {
      "requires_synthesis": {
        "type": "boolean",
        "required": true,
        "description": "Признак необходимости запуска синтеза для разрешённого действия."
      },
      "directory": {"type": "string", "required": true, "description": "Каталог запуска."},
      "runner": {"type": "string", "description": "Исполнительный модуль."},
      "model": {"type": "string", "description": "Модель выполнения."},
      "model_binding": {"type": "string", "description": "Привязка модели к ресурсу."}
    },
    "out": {
      "directive": {
        "type": "object",
        "required": true,
        "description": "Подготовленная исполнительная директива для запуска выполнения."
      }
    }
  }
}
