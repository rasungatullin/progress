{
  "name": "load-review-remarks",
  "kind": "repository.merge-request.comment.list",
  "title": "Получение замечаний ревизии",
  "type": "integration",
  "contract": {
    "in": {
      "invocation": {
        "type": "object",
        "description": "Ввод контура исполнения со связанным запросом на слияние."
      },
      "pull_request": {
        "type": "object",
        "description": "Загруженный запрос на слияние."
      },
      "repository": {
        "type": "string",
        "description": "Репозиторий запроса на слияние."
      },
      "number": {
        "type": "integer",
        "description": "Номер запроса на слияние."
      }
    },
    "out": {
      "review_remarks": {
        "type": "object_array",
        "description": "Загруженные замечания ревизии.",
        "required": true
      }
    }
  }
}
