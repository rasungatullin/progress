{
  "default_systems": {
    "issue": "github",
    "repo": "github",
    "messenger": "telegram"
  },
  "systems": {
    "github": {
      "type": "github",
      "integration_types": [
        "issue",
        "repo"
      ],
      "enabled": true,
      "transport": "api",
      "command": "gh",
      "token_env": "GITHUB_TOKEN",
      "timeout": "30s",
      "repository": "rasungatullin/progress",
      "default_repo": "rasungatullin/progress"
    },
    "telegram": {
      "type": "telegram",
      "integration_types": [
        "messenger"
      ],
      "enabled": true,
      "token_private": "tg_token",
      "chat_id": "1332534389"
    }
  }
}
