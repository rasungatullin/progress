{
  "default_systems": {
    "issue": "github",
    "repo": "github"
  },
  "systems": {
    "github": {
      "type": "github",
      "integration_types": [
        "issue",
        "repo"
      ],
      "enabled": true,
      "transport": "api",
      "command": "gh",
      "token_env": "GITHUB_TOKEN",
      "timeout": "30s",
      "repository": "rasungatullin/progress",
      "default_repo": "rasungatullin/progress"
    },
    "bitbucket": {
      "type": "bitbucket",
      "integration_types": [
        "repo"
      ],
      "enabled": true,
      "base_url": "https://stash.msk.avito.ru",
      "api_variant": "server",
      "token_env": "BITBUCKET_TOKEN",
      "workspace": "workspace",
      "repository": "workspace/repository"
    },
    "mattermost": {
      "type": "mattermost",
      "integration_types": [
        "messenger"
      ],
      "enabled": true,
      "base_url": "https://mattermost.example",
      "token_env": "MATTERMOST_TOKEN",
      "channel_id": "channel-id"
    },
    "telegram": {
      "type": "telegram",
      "integration_types": [
        "messenger"
      ],
      "enabled": true,
      "token_private": "tg_token",
      "chat_id": "chat-id"
    }
  }
}
